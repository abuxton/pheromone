{
  "name": "Pheromone Dev",
  "image": "mcr.microsoft.com/devcontainers/go:1.24",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest",
      "installDirectlyFromGitHubRelease": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "rust-lang.rust-analyzer",
        "github.copilot",
        "github.copilot-chat",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "zxh404.vscode-proto3",
        "timonwong.shellcheck",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "[go]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "golang.go"
        },
        "[rust]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "rust-analyzer.cargo.autoreload": true,
        "chat.agent.maxRequests": 256,
        "chat.tools.terminal.enableAutoApprove": true,
        "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",
        "chat.tools.terminal.autoApprove": {
          ".specify/scripts/bash/": true,
          ".specify/scripts/powershell/": true,
          ".foundations/scripts/bash/": true,
          ".foundations/scripts/powershell/": true,
          "/workspace/.foundations/scripts/bash/validate-env.sh": true,
          "./tmp": true,
          "bash": true,
          "pre-commit": true,
          "git": true,
          "ls": true,
          "cd": true,
          "cat": true,
          "echo": true,
          "mkdir": true,
          "mv": true,
          "terraform": true,
          "sed": true,
          "cut": true,
          "aws": true,
          "command": false,
          "curl": true,
          "rm": false,
          "export": true
        },
        "chat.promptFilesRecommendations": {
          "speckit.constitution": true,
          "speckit.specify": true,
          "speckit.plan": true,
          "speckit.tasks": true,
          "speckit.implement": true
        },
        "terminal.integrated.shellIntegration.enabled": true,
        "window.title": "${remoteName}"
      }
    }
  },
  "forwardPorts": [2379, 2380],
  "portsAttributes": {
    "2379": {
      "label": "etcd client",
      "onAutoForward": "silent"
    },
    "2380": {
      "label": "etcd peer",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "remoteUser": "vscode"
}

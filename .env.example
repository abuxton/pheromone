# Pheromone docker compose environment variables
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#
# This file is checked into version control as a template.
# The .env file containing real credentials must NOT be committed.

# ── PostgreSQL dataplane (ADR-016) — required when using --profile postgres ──
# POSTGRES_PASSWORD is mandatory. The postgres:16 image will refuse to
# start if this variable is unset or empty, providing a built-in safeguard.
#
# Generate a strong random password (≥32 characters recommended):
#   POSTGRES_PASSWORD=$(openssl rand -base64 32)
POSTGRES_PASSWORD=

# Optional overrides (defaults shown):
# POSTGRES_DB=pheromone
# POSTGRES_USER=pheromone

# ── Grafana ──────────────────────────────────────────────────────────────────
# GRAFANA_ANONYMOUS_ENABLED=false
# GRAFANA_ANONYMOUS_ORG_ROLE=Viewer

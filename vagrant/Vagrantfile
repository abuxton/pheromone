# -*- mode: ruby -*-
# vi: set ft=ruby :

# Pheromone Vagrant Multi-Machine Testing Environment
# ADR-012: Vagrant Testing Environment for Server and Agent Validation
#
# Usage:
#   vagrant up                     # Start all VMs
#   vagrant up server              # Start server VM only
#   vagrant up agent-ubuntu        # Start Ubuntu agent VM only
#   vagrant up agent-debian        # Start Debian 12 agent VM only
#   vagrant ssh server             # SSH into server
#   vagrant halt                   # Stop all VMs
#   vagrant destroy -f             # Destroy all VMs
#
# Requirements:
#   - Vagrant >= 2.3.0
#   - VirtualBox >= 6.1 (default provider)
#   - 8 GB RAM recommended (all three VMs: ~2 GB)

GO_VERSION = "1.24.1"
PROJECT_NAME = "pheromone"

# Network configuration (host-only private network)
SERVER_IP      = "192.168.56.10"
AGENT_UBUNTU_IP = "192.168.56.11"
AGENT_DEBIAN_IP = "192.168.56.12"

Vagrant.configure("2") do |config|
  # Disable default /vagrant sync; we use an explicit synced folder below
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # ─── Server VM ────────────────────────────────────────────────────────────
  config.vm.define "server" do |server|
    server.vm.box = "bento/ubuntu-24.04"
    server.vm.hostname = "pheromone-server"
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.provider "virtualbox" do |vb|
      vb.name   = "#{PROJECT_NAME}-server"
      vb.memory = 1024
      vb.cpus   = 2
      # Suppress VirtualBox GUI
      vb.gui = false
    end

    # Sync project root into the VM
    server.vm.synced_folder "..", "/home/vagrant/pheromone",
      type: "virtualbox"

    # Provisioning
    server.vm.provision "shell", path: "scripts/common.sh",
      env: { "GO_VERSION" => GO_VERSION }
    server.vm.provision "shell", path: "scripts/server.sh",
      env: {
        "SERVER_IP" => SERVER_IP,
        "GO_VERSION" => GO_VERSION
      }

    server.vm.post_up_message = <<~MSG
      Pheromone server VM is ready.
        SSH:    vagrant ssh server
        etcd:   http://#{SERVER_IP}:2379/health
        IP:     #{SERVER_IP}
    MSG
  end

  # ─── Agent VM (Ubuntu 24.04 LTS) ──────────────────────────────────────────
  config.vm.define "agent-ubuntu" do |agent|
    agent.vm.box = "bento/ubuntu-24.04"
    agent.vm.hostname = "pheromone-agent-ubuntu"
    agent.vm.network "private_network", ip: AGENT_UBUNTU_IP

    agent.vm.provider "virtualbox" do |vb|
      vb.name   = "#{PROJECT_NAME}-agent-ubuntu"
      vb.memory = 512
      vb.cpus   = 1
      vb.gui    = false
    end

    agent.vm.synced_folder "..", "/home/vagrant/pheromone",
      type: "virtualbox"

    agent.vm.provision "shell", path: "scripts/common.sh",
      env: { "GO_VERSION" => GO_VERSION }
    agent.vm.provision "shell", path: "scripts/agent.sh",
      env: {
        "SERVER_IP"  => SERVER_IP,
        "AGENT_IP"   => AGENT_UBUNTU_IP,
        "GO_VERSION" => GO_VERSION
      }

    agent.vm.post_up_message = <<~MSG
      Pheromone Ubuntu agent VM is ready.
        SSH:    vagrant ssh agent-ubuntu
        IP:     #{AGENT_UBUNTU_IP}
        Server: #{SERVER_IP}
    MSG
  end

  # ─── Agent VM (Debian 12 Bookworm) ────────────────────────────────────────
  config.vm.define "agent-debian" do |agent|
    agent.vm.box = "bento/debian-12"
    agent.vm.hostname = "pheromone-agent-debian"
    agent.vm.network "private_network", ip: AGENT_DEBIAN_IP

    agent.vm.provider "virtualbox" do |vb|
      vb.name   = "#{PROJECT_NAME}-agent-debian"
      vb.memory = 512
      vb.cpus   = 1
      vb.gui    = false
    end

    agent.vm.synced_folder "..", "/home/vagrant/pheromone",
      type: "virtualbox"

    agent.vm.provision "shell", path: "scripts/common.sh",
      env: { "GO_VERSION" => GO_VERSION }
    agent.vm.provision "shell", path: "scripts/agent.sh",
      env: {
        "SERVER_IP"  => SERVER_IP,
        "AGENT_IP"   => AGENT_DEBIAN_IP,
        "GO_VERSION" => GO_VERSION
      }

    agent.vm.post_up_message = <<~MSG
      Pheromone Debian 12 agent VM is ready.
        SSH:    vagrant ssh agent-debian
        IP:     #{AGENT_DEBIAN_IP}
        Server: #{SERVER_IP}
    MSG
  end
end
